---
import { u } from '../lib/url';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { GA_MEASUREMENT_ID, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image, type = 'website' } = Astro.props;
const fullTitle = title === SITE_TITLE ? title : `${title}｜${SITE_TITLE}`;
const useAnalytics = import.meta.env.PROD && GA_MEASUREMENT_ID !== '';
---

{
	useAnalytics && (
		<script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
			// 運営者の訪問を数えない仕組み。
			// ?notrack=1 を付けて一度開いたブラウザでは、以後ずっと計測しない（?notrack=0 で元に戻す）。
			(function () {
				var KEY = 'ai-raku-note:notrack';
				var off = false;
				try {
					var p = new URLSearchParams(location.search).get('notrack');
					if (p === '1') localStorage.setItem(KEY, '1');
					if (p === '0') localStorage.removeItem(KEY);
					off = localStorage.getItem(KEY) === '1';
				} catch (e) {}
				window.__notrack = off;
				if (off) return;
				var s = document.createElement('script');
				s.async = true;
				s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
				document.head.appendChild(s);
				window.dataLayer = window.dataLayer || [];
				window.gtag = function () {
					dataLayer.push(arguments);
				};
				gtag('js', new Date());
				gtag('config', id);
			})();
		</script>
	)
}

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href={u('/favicon.ico')} sizes="32x32" />
<link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
<link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
<link rel="sitemap" href={u('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL(u('/rss.xml'), Astro.site)} />
<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
