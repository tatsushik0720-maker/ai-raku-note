---
import { u } from '../lib/url';
import { SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<nav>
		<a href={u('/about/')}>運営者情報</a>
		<a href={u('/privacy/')}>プライバシーポリシー・免責事項</a>
		<a href={u('/contact/')}>お問い合わせ</a>
	</nav>
	<p>&copy; {year} {SITE_TITLE}</p>
</footer>
<style>
	footer {
		margin-top: 4rem;
		padding: 2rem 1rem 3rem;
		background: var(--bg-soft);
		color: var(--ink-soft);
		text-align: center;
		font-size: 0.85rem;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.25rem;
		margin-bottom: 1rem;
	}
	a {
		color: var(--ink-soft);
	}
</style>
