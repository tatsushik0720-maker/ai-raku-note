---
// 良い点と気になる点を左右に並べる（スマホでは上下）
interface Props {
	pros: string[];
	cons: string[];
}
const { pros, cons } = Astro.props;
---

<div class="pc">
	<div class="col pros">
		<p class="head">良い点</p>
		<ul>{pros.map((t) => <li>{t}</li>)}</ul>
	</div>
	<div class="col cons">
		<p class="head">気になる点</p>
		<ul>{cons.map((t) => <li>{t}</li>)}</ul>
	</div>
</div>

<style>
	.pc {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.8rem;
		margin: 1.6rem 0;
	}
	.col {
		padding: 0.8rem 1rem;
		border-radius: var(--radius);
		font-size: 0.92rem;
		line-height: 1.7;
	}
	.head {
		margin: 0 0 0.3rem !important;
		font-weight: 700;
	}
	ul {
		margin: 0 !important;
		padding-left: 1.2rem !important;
	}
	.pros {
		background: var(--good-soft);
	}
	.pros .head {
		color: var(--good);
	}
	.cons {
		background: var(--warn-soft);
	}
	.cons .head {
		color: var(--warn);
	}
	@media (max-width: 640px) {
		.pc {
			grid-template-columns: 1fr;
		}
	}
</style>
