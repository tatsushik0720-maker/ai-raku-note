---
import { u } from '../lib/url';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-title" href={u('/')}>{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href={u('/blog/')}>記事一覧</HeaderLink>
			<HeaderLink href={u('/about/')}>運営者</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		background: #fff;
		border-bottom: 1px solid var(--line);
	}
	nav {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 0 1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 56px;
	}
	.site-title {
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	@media (max-width: 400px) {
		.site-title {
			font-size: 0.95rem;
		}
	}
	.links {
		display: flex;
		gap: 0.25rem;
		flex-shrink: 0;
	}
</style>
