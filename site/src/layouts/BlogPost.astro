---
import { u } from '../lib/url';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { AUTHOR_BIO, AUTHOR_NAME, CATEGORIES, type CategoryKey, SITE_TITLE } from '../consts';

interface Props {
	data: CollectionEntry<'blog'>['data'];
	headings: MarkdownHeading[];
	related: CollectionEntry<'blog'>[];
}

const { data, headings, related } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, pr, category, tags } = data;
const cat = CATEGORIES[category as CategoryKey];
// 目次：h2 ごとに、その下の h3 をまとめる
const toc: { h: MarkdownHeading; subs: MarkdownHeading[] }[] = [];
for (const h of headings) {
	if (h.depth === 2) toc.push({ h, subs: [] });
	else if (h.depth === 3 && toc.length) toc[toc.length - 1].subs.push(h);
}
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

// 検索エンジン向けの構造化データ
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: AUTHOR_NAME },
	publisher: { '@type': 'Organization', name: SITE_TITLE },
	mainEntityOfPage: canonical,
};
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<nav class="crumbs" aria-label="パンくずリスト">
						<a href={u('/')}>ホーム</a> › <a href={u(`/blog/category/${category}/`)}>{cat.name}</a>
					</nav>
					<h1 class="title">{title}</h1>
					<div class="meta">
						<span>公開 <FormattedDate date={pubDate} /></span>
						{updatedDate && <span>更新 <FormattedDate date={updatedDate} /></span>}
					</div>
					{pr && (
						<p class="pr-notice">
							<span class="pr-badge">PR</span>
							この記事には広告（アフィリエイトリンク）が含まれます。リンクから購入や申し込みがあると、運営者に紹介料が入ります。紹介する内容や評価は、広告の有無で変えていません。
						</p>
					)}
					{heroImage && <Image class="hero" width={1200} height={630} src={heroImage} alt="" />}

					{headings.length >= 3 && (
						<details class="toc" open>
							<summary>目次</summary>
							<ol>
								{toc.map(({ h, subs }) => (
									<li>
										<a href={`#${h.slug}`}>{h.text}</a>
										{subs.length > 0 && (
											<ul>
												{subs.map((s) => (
													<li>
														<a href={`#${s.slug}`}>{s.text}</a>
													</li>
												))}
											</ul>
										)}
									</li>
								))}
							</ol>
						</details>
					)}

					<slot />

					{tags.length > 0 && (
						<ul class="tags">
							{tags.map((t) => (
								<li>#{t}</li>
							))}
						</ul>
					)}

					<aside class="author">
						<p class="author-name">この記事を書いた人：{AUTHOR_NAME}</p>
						<p>{AUTHOR_BIO}</p>
						<a href={u('/about/')}>運営者情報を見る</a>
					</aside>
				</div>

				{related.length > 0 && (
					<section class="related">
						<h2>同じカテゴリの記事</h2>
						<div class="grid">
							{related.map((p) => (
								<PostCard post={p} />
							))}
						</div>
					</section>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.crumbs {
		font-size: 0.82rem;
		color: var(--ink-soft);
	}
	.crumbs a {
		color: var(--ink-soft);
	}
	.title {
		margin: 0.6rem 0 0.4rem;
		font-size: 1.75rem;
	}
	.meta {
		display: flex;
		gap: 1rem;
		font-size: 0.85rem;
		color: var(--ink-soft);
		margin-bottom: 1rem;
	}
	.pr-notice {
		display: flex;
		gap: 0.6rem;
		align-items: flex-start;
		padding: 0.7rem 0.9rem;
		font-size: 0.82rem;
		line-height: 1.7;
		color: var(--ink-soft);
		background: var(--bg-soft);
		border-radius: 8px;
	}
	.pr-badge {
		flex-shrink: 0;
		padding: 0 0.5em;
		font-weight: 700;
		color: #fff;
		background: var(--ink-soft);
		border-radius: 4px;
	}
	:global(.hero) {
		border-radius: var(--radius);
		margin: 1rem 0 1.5rem;
	}
	.toc {
		margin: 1.5rem 0 2rem;
		padding: 0.8rem 1.1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: #fff;
	}
	.toc summary {
		font-weight: 700;
		cursor: pointer;
	}
	.toc ol {
		margin: 0.5rem 0 0;
		padding-left: 1.3rem;
		font-size: 0.92rem;
		line-height: 1.7;
	}
	.toc ul {
		margin: 0;
		padding-left: 1rem;
		list-style: '- ';
		font-size: 0.86rem;
	}
	.toc a {
		color: var(--ink);
		text-decoration: none;
	}
	.toc a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 2.5rem 0 1rem;
		font-size: 0.82rem;
	}
	.tags li {
		padding: 0.1rem 0.6rem;
		background: var(--bg-soft);
		border-radius: 999px;
		color: var(--ink-soft);
	}
	.author {
		margin-top: 1.5rem;
		padding: 1.1rem 1.2rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		font-size: 0.9rem;
		line-height: 1.75;
	}
	.author p {
		margin: 0 0 0.5rem;
	}
	.author-name {
		font-weight: 700;
	}
	.related {
		max-width: var(--wide);
		margin: 4rem auto 0;
	}
	.related h2 {
		font-size: 1.2rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1rem;
	}
	@media (max-width: 720px) {
		.title {
			font-size: 1.4rem;
		}
	}
</style>
